{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Delivery and GitOps health for crosswords, observed from the cluster side. SCOPE: everything here is derived from kube-state-metrics and the Flux controllers — it measures what actually landed on the cluster. It does NOT measure the CI side (build duration, test pass rate, merge-to-deploy lead time), because no GitHub Actions metrics are exported anywhere today. Deploy frequency below counts Deployment spec changes reaching the cluster, which for staging is driven by Flux image automation on every merge to main, and for production by a manual pinned-tag promotion.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Deploy Frequency",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Number of Deployment spec generations observed over the selected time range — i.e. how many times each environment actually changed. Counted on kube_deployment_status_observed_generation, which increments on every applied spec change. Expect staging to be far higher than production: staging is auto-bumped by Flux image automation on every merge to main, production is a manually promoted pinned tag.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Deploys in range",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "changes(kube_deployment_status_observed_generation{namespace=\"apps\", deployment=~\"definitely-not-crosswords(-staging)?\"}[$__range])",
          "legendFormat": "{{deployment}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Deploys per bucket, per environment. Uses $__interval so each bar counts a discrete, non-overlapping window rather than a rolling sum. Gaps in the production series are the promotion cadence; a long flat production line next to a busy staging line is the staging-to-prod drift this app is prone to.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Deploys per bucket",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "changes(kube_deployment_status_observed_generation{namespace=\"apps\", deployment=~\"definitely-not-crosswords(-staging)?\"}[$__interval])",
          "legendFormat": "{{deployment}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Currently-running container image per environment, straight from kube_pod_container_info. This is the ground-truth answer to 'what is actually serving right now', and the fastest way to spot staging/production version drift. Production carries a semver tag (pinned promotion); staging carries a git commit SHA (Flux image automation).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "title": "Running image per environment",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "kube_pod_container_info{namespace=\"apps\", pod=~\"definitely-not-crosswords.*\", container=~\"definitely-not-crosswords.*\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container_id": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "service": true,
              "uid": true
            },
            "indexByName": {
              "pod": 0,
              "container": 1,
              "image_spec": 2,
              "image": 3,
              "image_id": 4
            },
            "renameByName": {
              "image_id": "Resolved digest",
              "image_spec": "Image (spec)",
              "pod": "Pod"
            }
          }
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 5,
      "title": "Flux Reconciliation",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Flux helm-controller reconcile rate for the two HelmReleases. Both are configured with a 10m interval, so a healthy steady state is roughly 0.0017/s each. A drop to zero means the controller stopped reconciling this release — the release could be stale without anything else looking wrong.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "mappings": [],
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "HelmRelease reconcile rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (name) (rate(gotk_reconcile_duration_seconds_count{namespace=\"apps\", kind=\"HelmRelease\", name=~\"definitely-not-crosswords.*\"}[15m]))",
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Mean reconcile duration per HelmRelease, computed as rate(sum)/rate(count) so it is correct whether the underlying metric is a histogram or a summary. A sustained climb usually means the release is retrying a failing upgrade.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Mean reconcile duration",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (name) (rate(gotk_reconcile_duration_seconds_sum{namespace=\"apps\", kind=\"HelmRelease\", name=~\"definitely-not-crosswords.*\"}[15m]))\n/ sum by (name) (rate(gotk_reconcile_duration_seconds_count{namespace=\"apps\", kind=\"HelmRelease\", name=~\"definitely-not-crosswords.*\"}[15m]))",
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Deployment spec generation minus observed generation. Anything other than 0 means the desired spec has not been fully rolled out — a stuck or in-flight rollout. Sustained non-zero is the signal that a deploy silently failed to converge.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "id": 8,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Rollout lag (spec − observed generation)",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "kube_deployment_metadata_generation{namespace=\"apps\", deployment=~\"definitely-not-crosswords(-staging)?\"}\n- on (namespace, deployment) kube_deployment_status_observed_generation{namespace=\"apps\", deployment=~\"definitely-not-crosswords(-staging)?\"}",
          "legendFormat": "{{deployment}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Replicas the Deployment wants but does not have. Non-zero means the environment is degraded or fully down; with replicaCount=1 there is no partial state, so 1 here means zero endpoints behind the Service.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "id": 9,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Unavailable replicas",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas_unavailable{namespace=\"apps\", deployment=~\"definitely-not-crosswords(-staging)?\"}",
          "legendFormat": "{{deployment}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "id": 10,
      "title": "Scheduled Jobs",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Time since the weekly game-seed CronJob last fired on staging. It is scheduled at 06:00 on Mondays, so this sawtooths up to about seven days. A value climbing past that is a CronJob that stopped firing — a class of silent failure with no other detector today.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 604800
              },
              {
                "color": "red",
                "value": 691200
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "id": 11,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Time since last game-seed run",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "time() - kube_cronjob_status_last_schedule_time{namespace=\"apps\", cronjob=~\"definitely-not-crosswords.*game-seed\"}",
          "legendFormat": "{{cronjob}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Point-in-time count of game-seed Job OBJECTS currently retained by the CronJob, split by state — NOT a history of runs. The CronJob sets successfulJobsHistoryLimit=1 and failedJobsHistoryLimit=2, so Kubernetes garbage-collects older Jobs and their kube_job_status_* series disappear with them. Read this as 'is there a failed run sitting around right now', not 'how many runs succeeded this week'. Run history over time is not recoverable from kube-state-metrics; the 'time since last game-seed run' stat is the reliable liveness signal. Note the label is job_name, not job.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*failed.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*succeeded.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "id": 12,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Retained game-seed Jobs by state",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(kube_job_status_succeeded{namespace=\"apps\", job_name=~\"definitely-not-crosswords.*game-seed.*\"})",
          "legendFormat": "succeeded",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(kube_job_status_failed{namespace=\"apps\", job_name=~\"definitely-not-crosswords.*game-seed.*\"})",
          "legendFormat": "failed",
          "range": true,
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "crosswords",
    "delivery",
    "gitops"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "value": "prometheus"
        },
        "hide": 2,
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "utc",
  "title": "Crosswords Delivery & GitOps",
  "uid": "crosswords-delivery",
  "version": 1,
  "weekStart": ""
}
