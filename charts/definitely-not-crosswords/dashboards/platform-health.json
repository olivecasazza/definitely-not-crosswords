{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Health-state timeline for the crosswords workloads across staging and production, built only from kube-state-metrics, cAdvisor, Longhorn and Loki — no application instrumentation required. READ THIS FIRST: every health signal on this dashboard is ultimately derived from a readinessProbe against /api/healthz, which is implemented as `|| async { \"ok\" }` — it runs no database query and verifies no schema. Green therefore means 'the axum process is up and routing', NOT 'the service works'. This dashboard would not have caught the six-week schema drift that broke signups, and it would not have caught the 2026-08-08 routing outage in which pods stayed Ready while users received Cloudflare 530s. A genuine endpoint-level health signal requires deploying blackbox-exporter and a Probe CR against the public hostnames; a genuine app-level signal requires the /metrics endpoint the server does not yet expose.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Health State Timeline",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "PRIMARY health signal. Available replicas per Deployment, as a state timeline. This is the series to trust during an outage: it persists at 0 while the environment is down, whereas per-pod readiness series DISAPPEAR when the pod dies (rendering as an empty gap that reads as 'no data' rather than 'down'). With replicaCount=1 and no PodDisruptionBudget there is no partial state \u2014 0 here means zero endpoints behind the Service and users get a Cloudflare 530. CAVEAT: 'Serving' still only means a pod passed a readinessProbe against /api/healthz, which returns a static \"ok\" without touching the database. It does not mean the app works \u2014 during the six-week schema drift this row was green the entire time while signups were broken.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": true
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "No endpoints"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "Serving"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "title": "Service availability \u2014 staging and production",
      "type": "state-timeline",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas_available{namespace=\"apps\", deployment=~\"definitely-not-crosswords(-staging)?\"}",
          "legendFormat": "{{deployment}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "SECONDARY / diagnostic. Per-pod readiness. Read this for which pod was serving and when, not for whether the service was up. Two properties make it misleading on its own: the series is keyed by pod name, so it vanishes rather than going red when a pod is evicted or replaced; and every staging deploy mints a new pod name, so this timeline accrues one row per deploy over a long window. Use the 'Service availability' panel above for the actual up/down question.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "Not Ready"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "Ready"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 13,
      "options": {
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "title": "Pod readiness (per pod, diagnostic)",
      "type": "state-timeline",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (pod) (kube_pod_status_ready{namespace=\"apps\", pod=~\"definitely-not-crosswords.*\", condition=\"true\"})",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Postgres StatefulSet ready replicas. Each environment runs a single-node postgres:16-alpine StatefulSet (not CloudNativePG), so there is no Postgres exporter and no query-level, connection-level or replication metrics \u2014 only this pod-level readiness.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Postgres ready replicas",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "kube_statefulset_status_replicas_ready{namespace=\"apps\", statefulset=~\"definitely-not-crosswords.*postgres\"}",
          "legendFormat": "{{statefulset}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Container restarts in the last hour. A restarting app container is one of the few app-level failure signals available without instrumentation \u2014 the Rust server logs a panic and exits, and this counts it.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Container restarts (1h)",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"apps\", pod=~\"definitely-not-crosswords.*\"}[1h]))",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 6,
      "title": "Storage",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Longhorn volume state for the two Postgres PVCs. 2 = attached (healthy). NOTE: longhorn-manager is a per-node DaemonSet and each instance only reports volumes attached on its own node, hence the `max by (pvc)` aggregation \u2014 a bare selector would produce gaps as volumes move between nodes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "options": {
                "1": {
                  "color": "yellow",
                  "index": 0,
                  "text": "Creating"
                },
                "2": {
                  "color": "green",
                  "index": 1,
                  "text": "Attached"
                },
                "3": {
                  "color": "red",
                  "index": 2,
                  "text": "Detached"
                },
                "4": {
                  "color": "yellow",
                  "index": 3,
                  "text": "Attaching"
                },
                "5": {
                  "color": "orange",
                  "index": 4,
                  "text": "Detaching"
                },
                "6": {
                  "color": "red",
                  "index": 5,
                  "text": "Deleting"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 0,
        "y": 21
      },
      "id": 7,
      "options": {
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "title": "Longhorn volume state \u2014 Postgres PVCs",
      "type": "state-timeline",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (pvc) (longhorn_volume_state{pvc=~\"data-definitely-not-crosswords.*postgres-0\"})",
          "legendFormat": "{{pvc}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Provisioned capacity of the Postgres PVCs. There is no filesystem-usage metric for these volumes today (no node-exporter textfile collector or Postgres exporter scoped to them), so this shows allocation only \u2014 not how full the database actually is.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "PVC provisioned capacity",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "kube_persistentvolumeclaim_resource_requests_storage_bytes{namespace=\"apps\", persistentvolumeclaim=~\"data-definitely-not-crosswords.*\"}",
          "legendFormat": "{{persistentvolumeclaim}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "id": 9,
      "title": "Logs (Loki)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Rate of error-shaped log lines shipped by promtail. This is the ONLY app-level error signal available without instrumenting the server. Its coverage is thin by design of the current code: there are zero tracing calls in any tRPC router, in auth_routes.rs or in checkout.rs, and no request-logging middleware \u2014 so failed logins, failed signups, failed checkouts and tRPC errors produce no log line at all and will NOT appear here. Adding a tower-http TraceLayer would make this panel meaningful.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Error-shaped log lines per 5m",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (count_over_time({namespace=\"apps\", pod=~\"definitely-not-crosswords.*\"} |~ \"(?i)(error|panic|fatal|thread '.*' panicked)\" [5m]))",
          "legendFormat": "{{pod}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Raw error-shaped log lines from both environments, newest first. Useful for the failure classes that DO log today: SMTP send failures (mailer.rs), Lemon Squeezy webhook processing (webhook.rs), and the stale generation-job reaper (main.rs).",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "id": 11,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "Recent error logs",
      "type": "logs",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{namespace=\"apps\", pod=~\"definitely-not-crosswords.*\"} |~ \"(?i)(error|panic|fatal|thread '.*' panicked)\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ],
